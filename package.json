{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Atlas: every SKILL.md in a repository, in the terminal or a local web view.",
  "type": "module",
  "bin": {
    "skill-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:web",
    "test:unit": "node --test tests/*.test.ts",
    "test:web": "playwright test",
    "e2e": "node --test e2e/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "playwright test -c demos/playwright.config.ts",
    "demo:record": "DEMO_RECORD=1 playwright test -c demos/playwright.config.ts --workers=1"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.0",
    "typescript": "^7.0.2"
  }
}
